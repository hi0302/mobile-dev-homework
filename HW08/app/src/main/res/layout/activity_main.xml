<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.group1.hw08.ScoreViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/title_kabaddi"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Team A Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/team_a"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scoreViewA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@{String.valueOf(viewModel.scoreA)}"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="0" />

            <Button
                android:id="@+id/plusOneButtonA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plus_one_team_a" />

            <TextView
                android:id="@+id/resultViewA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:text="@{viewModel.resultA}"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="A Wins" />

            <!-- Team B Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/team_b"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scoreViewB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@{String.valueOf(viewModel.scoreB)}"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="0" />

            <Button
                android:id="@+id/plusOneButtonB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plus_one_team_b" />

            <TextView
                android:id="@+id/resultViewB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:text="@{viewModel.resultB}"
                android:textColor="#C62828"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="B Wins" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="?android:attr/listDivider" />

            <!-- Selected Team Section (switchMap) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selected_team_label"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/selectedTeamView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:text="@{viewModel.selectedTeam}"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Team A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/selected_score_label"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/selectedScoreView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:text="@{String.valueOf(viewModel.selectedScore)}"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="0" />

            <Button
                android:id="@+id/selectTeamButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_select_team" />

            <Button
                android:id="@+id/resetButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_reset" />

        </LinearLayout>
    </ScrollView>
</layout>
