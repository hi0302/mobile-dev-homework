<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/header_top"
        android:orientation="vertical">
        <TextView style="@style/SectionLabel"
            android:text="@string/directory_label" android:textColor="@color/accent" />
        <FrameLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/txtContactsTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginEnd="58dp" android:layout_gravity="center_vertical"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.03" android:text="@string/contacts_title"
                android:textColor="@color/ink" android:textSize="@dimen/title_size" />
            <ImageView
                android:id="@+id/imgBrand"
                android:layout_width="42dp" android:layout_height="42dp"
                android:layout_gravity="end|center_vertical" android:background="@drawable/bg_brand"
                android:importantForAccessibility="no" android:src="@drawable/ic_launcher_foreground" />
        </FrameLayout>
        <TextView
            android:id="@+id/txtDirectorySummary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/secondary_ink" android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap" android:layout_marginBottom="10dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/SectionLabel"
                android:layout_width="0dp" android:layout_weight="1" android:text="@string/all_contacts_label" />
            <TextView
                android:id="@+id/txtContactRange"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/secondary_ink" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/screen_margin">
        <ListView
            android:id="@+id/listContacts"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:divider="@null" android:dividerHeight="0dp"
            android:overScrollMode="ifContentScrolls" android:scrollbars="vertical" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin" android:layout_marginTop="12dp"
        android:background="@drawable/bg_panel" android:orientation="vertical"
        android:paddingHorizontal="16dp" android:paddingVertical="@dimen/selection_padding">
        <TextView style="@style/SectionLabel" android:text="@string/selection_label" />
        <TextView
            android:id="@+id/txtChoose"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:accessibilityLiveRegion="polite"
            android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:textSize="16sp" />
        <TextView
            android:id="@+id/txtSelectionDetail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/secondary_ink" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pageBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="12dp">
        <TextView
            android:id="@+id/txtPageSummary"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:accessibilityLiveRegion="polite" android:textColor="@color/secondary_ink" android:textSize="13sp" />
        <Button android:id="@+id/btnPage1" style="@style/PageButton" android:text="@string/page_1" />
        <Button android:id="@+id/btnPage2" style="@style/PageButton" android:text="@string/page_2" />
        <Button android:id="@+id/btnPage3" style="@style/PageButton" android:text="@string/page_3" />
    </LinearLayout>
</LinearLayout>
